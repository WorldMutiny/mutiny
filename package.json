{
  "name": "mutiny",
  "productName": "Mutiny",
  "version": "0.9.0-beta.3",
  "description": "A distraction-free essay writer with an optional AI research & critique assistant.",
  "homepage": "https://github.com/worldmutiny/mutiny",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder --mac",
    "package:win": "electron-builder --win",
    "package:linux": "electron-builder --linux",
    "package:all": "electron-builder --mac --win --linux"
  },
  "build": {
    "appId": "com.worldmutiny.mutiny",
    "productName": "Mutiny",
    "publish": {
      "provider": "github",
      "owner": "worldmutiny",
      "repo": "mutiny"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "identity": "-"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Office",
      "synopsis": "A distraction-free essay writer",
      "desktop": {
        "entry": {
          "Comment": "A distraction-free essay writer",
          "Keywords": "writing;writer;essay;article;opinion;research;"
        }
      },
      "maintainer": "Maxx Darko <mutiny@worldmutiny.com>",
      "artifactName": "Mutiny-${version}-linux-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Mutiny-${version}-windows-setup.${ext}"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!Backups/**",
      "!*.md",
      "!.github/**",
      "!Claude outputs/**",
      "!scripts/**",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "portable": {
      "artifactName": "Mutiny-${version}-windows-portable.${ext}"
    },
    "dmg": {
      "artifactName": "Mutiny-${version}-mac-${arch}.${ext}"
    }
  },
  "author": {
    "name": "Maxx Darko",
    "email": "mutiny@worldmutiny.com",
    "url": "https://worldmutiny.com"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@anthropic-ai/sdk": "^0.128.0",
    "dictionary-en-us": "^2.2.1",
    "dictionary-es": "^4.0.0",
    "electron-updater": "^6.3.9",
    "jszip": "^3.10.1",
    "nspell": "^2.1.5"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "electron-winstaller": false
  }
}
