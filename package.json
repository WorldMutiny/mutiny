{
  "name": "mutiny",
  "productName": "Mutiny",
  "version": "0.1.0",
  "description": "A distraction-free essay writer with an optional AI research & critique assistant.",
  "homepage": "https://github.com/worldmutiny/mutiny",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder --mac",
    "package:win": "electron-builder --win",
    "package:linux": "electron-builder --linux",
    "package:all": "electron-builder --mac --win --linux"
  },
  "build": {
    "appId": "com.worldmutiny.mutiny",
    "productName": "Mutiny",
    "publish": {
      "provider": "github",
      "owner": "worldmutiny",
      "repo": "mutiny"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Office",
      "synopsis": "A distraction-free word processor for authors",
      "desktop": {
        "entry": {
          "Comment": "A word processor for authors. Distraction-free by default.",
          "Keywords": "writing;writer;novel;book;author;manuscript;wordprocessor;"
        }
      },
      "maintainer": "Maxx Darko <mutiny@worldmutiny.com>"
    },
    "nsis": {
      "oneClick": true,
      "deleteAppDataOnUninstall": false
    },
    "files": [
      "**/*",
      "!pocket/**",
      "!dist/**",
      "!Backups/**",
      "!*.md",
      "!.github/**",
      "!Claude outputs/**",
      "!scripts/**",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ]
  },
  "author": "Maxx (fork of NEO by Hugh Howey)",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@anthropic-ai/sdk": "^0.128.0",
    "dictionary-en-us": "^2.2.1",
    "dictionary-es": "^4.0.0",
    "electron-updater": "^6.3.9",
    "jszip": "^3.10.1",
    "nspell": "^2.1.5"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "electron-winstaller": false
  }
}
